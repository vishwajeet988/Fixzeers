PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixzeers
JWT_SECRET=change-this-in-development
OTP_HASH_SECRET=change-this-otp-hash-secret-in-development
CORS_ORIGIN=http://localhost:5500,https://fixzeers.vercel.app
ENABLE_DEV_OTP_LOGS=false
OTP_PROVIDER=console
# QA only; never set QA_OTP_ENABLED=true in production.
QA_OTP_ENABLED=false
QA_OTP_PHONE_NUMBERS=
# Required in production when OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
